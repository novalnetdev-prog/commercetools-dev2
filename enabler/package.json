    "vite": "6.4.5",
    "vite-plugin-css-injected-by-js": "3.5.2",
    "jest-environment-jsdom": "30.5.2",
    "@types/jest": "30.0.0"
  },
  "overrides": {
    "path-to-regexp": "3.3.0",
    "compression": "1.8.2",
