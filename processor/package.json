{
  "name": "payment-integration-novalnet",
  "version": "1.0.0",
  "description": "Novalnet payment integration for commercetools Checkout",
  "main": "dist/main.js",
  "scripts": {
    "start": "node dist/main.js",
    "start:dev": "node --watch dist/main.js",
    "lint": "prettier --check \"**/**/*.{ts,js,json}\" && eslint src test",
    "lint:fix": "prettier --write \"**/**/*.{ts,js,json}\" && eslint --fix src test",
    "build": "rm -rf dist && tsc",
    "dev": "ts-node src/main.ts",
    "watch": "node --watch --require ts-node/register src/main.ts",
    "test": "jest --detectOpenHandles",
    "test:watch": "jest --watch --detectOpenHandles",
    "connector:post-deploy": "node dist/connectors/post-deploy.js",
    "connector:pre-undeploy": "node dist/connectors/pre-undeploy.js"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@commercetools-backend/loggers": "^27.4.2",
    "@commercetools/connect-payments-sdk": "^0.28.0",
    "@commercetools/platform-sdk": "8.25.0",
    "@commercetools/sdk-client-v2": "^2.5.0",
    "@fastify/autoload": "6.3.0",
    "@fastify/cors": "11.0.1",
    "@fastify/formbody": "8.0.2",
    "@fastify/request-context": "6.2.0",
    "@fastify/type-provider-typebox": "5.1.0",
    "@sinclair/typebox": "0.33.22",
    "dotenv": "16.5.0",
    "fastify": "^5.8.5",
    "fastify-plugin": "5.0.1",
    "json-bigint": "^1.0.0",
    "fastify-raw-body": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/compat": "^1.2.9",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.26.0",
    "@jest/globals": "30.5.2",
    "@types/jest": "30.0.0",
    "@types/node": "22.15.3",
    "@typescript-eslint/eslint-plugin": "8.72.0",
    "@typescript-eslint/parser": "8.72.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "10.1.2",
    "eslint-plugin-jest": "29.17.0",
    "eslint-plugin-prettier": "5.4.0",
    "eslint-plugin-unused-imports": "4.1.4",
    "globals": "^16.0.0",
    "jest": "30.5.2",
    "prettier": "3.5.3",
    "ts-jest": "29.4.15",
    "ts-node": "10.9.2",
    "typescript": "5.8.3",
    "@types/json-bigint": "^1.0.0"
  },
  "overrides": {
    "path-to-regexp": "3.3.0",
    "lodash": "^4.17.24",
    "minimatch@^3": "3.1.4",
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^4.1.1"
    }
  },
  "engines": {
    "node": ">=22 <25"
  }
}
